# 复制为 .env.local 并填入真实值（.env.local 已在 .gitignore 中，不会被提交）

# 数据库（PostgreSQL）
DATABASE_URL=postgresql://postgres:your_password@localhost:15432/eduagent

# Milvus 向量库
MILVUS_HOST=localhost
MILVUS_PORT=19530

# HuggingFace 镜像（国内下载 embedding/reranker 模型用）
HF_ENDPOINT=https://hf-mirror.com

# LLM（OpenAI 兼容接口，如 DeepSeek）
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-api-key
LLM_MODEL=deepseek-chat

# JWT
JWT_SECRET=change-me-to-a-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# 服务
SERVER_HOST=0.0.0.0
SERVER_PORT=8801
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
